# Server Configuration
PORT=5000
NODE_ENV=development

# MongoDB Configuration
MONGODB_URI=mongodb://127.0.0.1:27017/imovies
MONGODB_TEST_URI=mongodb://127.0.0.1:27017/imovies_test

# Client CORS Configuration
CORS_ORIGIN=http://localhost:5173

# JWT Authentication
JWT_SECRET=your_jwt_secret_key_min_32_characters_here_for_security
JWT_EXPIRES_IN=7d